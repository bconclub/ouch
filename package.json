{
  "name": "ouch",
  "version": "1.0.0",
  "description": "Ouch \u2014 piercing & piercing supplies e-commerce platform",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "node --env-file=.env --import tsx src/seed.ts",
    "covers": "node --env-file=.env --import tsx scripts/set-category-covers.ts",
    "clear-demo": "node --env-file=.env --import tsx scripts/clear-demo-catalogue.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "posters": "node --env-file=.env --import tsx scripts/add-poster.ts"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.87.1",
    "@payloadcms/next": "3.87.1",
    "@payloadcms/richtext-lexical": "3.87.1",
    "@payloadcms/storage-vercel-blob": "^3.87.1",
    "@payloadcms/ui": "3.87.1",
    "cross-env": "10.1.0",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.3.0",
    "payload": "3.87.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.11",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}