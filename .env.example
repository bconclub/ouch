DATABASE_URL=file:./ouch.db
PAYLOAD_SECRET=YOUR_SECRET_HERE

# --- Production (Vercel) ---
# Hosted libSQL/Turso database — a serverless filesystem cannot hold SQLite
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=your-turso-token
# Uploads bucket (Vercel Blob). Without it, uploads write to ./media (local only)
# BLOB_READ_WRITE_TOKEN=your-vercel-blob-token
